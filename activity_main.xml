<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_main">
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:padding="6dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/panel" android:padding="10dp">
    <TextView android:id="@+id/tvCity" android:textColor="#FFF" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextClock android:format12Hour="EEEE - MMM d" android:format24Hour="EEEE - MMM d" android:textColor="#FFF" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
     <TextClock android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:textColor="#FFF" android:textSize="44sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
     <TextView android:id="@+id/tvTemp" android:text="--°C" android:gravity="end" android:textColor="#FFF" android:textSize="30sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView android:id="@+id/tvInfo" android:textColor="#CFE" android:textSize="12sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/tvForecast" android:textColor="#FFF" android:textSize="12sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   </LinearLayout>
   <FrameLayout android:id="@+id/mapBox" android:background="@drawable/panel" android:padding="4dp" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2"/>
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
   <FrameLayout android:id="@+id/speedBox" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2"/>
   <FrameLayout android:id="@+id/roadBox" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:padding="6dp">
   <LinearLayout android:id="@+id/radioPanel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/panel_black" android:gravity="center">
    <TextView android:id="@+id/tvFreq" android:text="106.2" android:textColor="#FFF" android:textSize="40sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
     <Button android:id="@+id/fPrev" android:text="◀" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
     <Button android:id="@+id/fRadio" android:text="FM" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
     <Button android:id="@+id/fNext" android:text="▶" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
   </LinearLayout>
   <GridLayout android:id="@+id/bigGrid" android:columnCount="2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.4"/>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/dock" android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/dock" android:paddingStart="16dp" android:paddingEnd="16dp"/>
</LinearLayout>
